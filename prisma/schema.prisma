generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; valid values enforced in app code:
// "DISCONNECTED" | "CONNECTING" | "CONNECTED"
model WhatsAppAccount {
  id          String          @id @default(cuid())
  name        String
  phoneNumber String?
  status      String          @default("DISCONNECTED")
  authDir     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  groups      WhatsAppGroup[] @relation("PrimaryAccount")
  backupFor   WhatsAppGroup[] @relation("BackupAccount")
}

model WhatsAppGroup {
  id                String            @id @default(cuid())
  jid               String            @unique
  name              String
  isMonitoring      Boolean           @default(false)
  isSending         Boolean           @default(false)
  // Comma-separated marketplace ids (e.g. "shopee,amazon"). Empty string = todas aceitas.
  monitoredMarketplaces String        @default("")
  // Reaproveita a imagem original da mensagem capturada em vez de gerar link preview.
  useOriginalImage  Boolean           @default(true)
  // So um grupo deveria ter isso ativo por vez (e o "controle remoto" do bot).
  isAutomationGroup Boolean           @default(false)
  participantsCount Int               @default(0)
  lastSyncedAt      DateTime          @default(now())
  account           WhatsAppAccount   @relation("PrimaryAccount", fields: [accountId], references: [id])
  accountId         String
  // Se a conta principal cair, envio tenta essa conta (precisa ja ser membro do mesmo grupo).
  backupAccount     WhatsAppAccount?  @relation("BackupAccount", fields: [backupAccountId], references: [id])
  backupAccountId   String?
  capturedProducts  CapturedProduct[]
}

model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  // "shopee" | "amazon" | "mercadolivre" | "" (generico, serve pra qualquer marketplace)
  marketplace String  @default("")
  content    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// SQLite has no native enum support in Prisma; valid values enforced in app code:
// "CAPTURED" | "CONVERTED" | "CONVERSION_FAILED"
model CapturedProduct {
  id              String        @id @default(cuid())
  sourceUrl       String
  dedupeKey       String
  marketplace     String
  affiliateUrl    String?
  status          String        @default("CAPTURED")
  conversionError String?
  messageText     String?
  // Caminho local do arquivo (data/media/...), quando o grupo usa "imagem original".
  imagePath       String?
  // salvar_prioridade: entra na frente da fila do disparo automatico.
  priority        Boolean       @default(false)
  // Marcado quando o disparo automatico ja mandou esse produto (evita repetir).
  dispatchedAt    DateTime?
  favorite        Boolean       @default(false)
  // Overrides manuais (tela "Editar produto") - tem prioridade sobre o que a
  // heuristica extrai de messageText quando preenchidos.
  nameOverride           String?
  priceOriginalOverride  String?
  priceDiscountedOverride String?
  couponOverride         String?
  sourceGroup     WhatsAppGroup @relation(fields: [sourceGroupId], references: [id])
  sourceGroupId   String
  capturedAt      DateTime      @default(now())

  @@index([dedupeKey])
  @@index([capturedAt])
}

model ScheduledMessage {
  id         String    @id @default(cuid())
  // ids de WhatsAppGroup, separados por virgula
  groupIds   String
  text       String?
  productId  String?
  templateId String?
  scheduledAt DateTime
  // "PENDING" | "SENT" | "FAILED" | "CANCELLED"
  status     String    @default("PENDING")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, scheduledAt])
}

model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                 String   @id @default("singleton")
  shopeeAppId        String   @default("")
  shopeeAppSecret    String   @default("")
  shopeeSubIds       String   @default("") // comma-separated
  amazonAffiliateTag String   @default("")
  // matt_word - https://mercadolivre.com/...?matt_word=X&matt_tool=Y
  mercadoLivreTag    String   @default("")
  // matt_tool - codigo numerico do cadastro de afiliado, confirmado via link real gerado no portal
  mercadoLivreCode   String   @default("")
  updatedAt          DateTime @updatedAt
}

model MonitoringSettings {
  id                String   @id @default("singleton")
  restrictedWords   String   @default("") // comma-separated
  allowedWords      String   @default("") // comma-separated
  dedupeWindowHours Int      @default(12)
  updatedAt         DateTime @updatedAt
}

// Lancamentos financeiros (Financeiro). Valores em CENTAVOS (Int) pra evitar
// erro de ponto flutuante nas somas - a API converte de/para reais.
// SQLite nao tem enum: valores validos garantidos no app:
//   tipo:       "gasto" | "ganho"
//   plataforma: "meta" | "mercadolivre" | "amazon" | "shopee" | "outro"
//   status:     "pendente" | "aprovado" | "pago" | "cancelado"
//   origem:     "manual" | "api"
model FinancialEntry {
  id                String   @id @default(cuid())
  tipo              String
  plataforma        String
  valorCents        Int
  moeda             String   @default("BRL")
  status            String   @default("pendente")
  dataEvento        DateTime
  dataSincronizacao DateTime?
  origem            String   @default("manual")
  referenciaExterna String?
  descricao         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([dataEvento])
  @@index([plataforma])
  @@index([tipo, status])
}

// Credenciais de integracao com APIs externas (Fase 2+). O campo `credenciaisEnc`
// guarda o segredo (ex: access token) CRIPTOGRAFADO com AES-256-GCM - nunca em
// texto puro. `segmentoId` (ex: id da conta de anuncios act_...) nao e segredo.
// SQLite sem enum: statusConexao = "desconectado" | "conectado" | "erro".
model IntegrationCredential {
  id                  String    @id @default(cuid())
  plataforma          String    @unique
  tipoAutenticacao    String    @default("token")
  credenciaisEnc      String    @default("")
  segmentoId          String?
  statusConexao       String    @default("desconectado")
  statusMensagem      String?
  ultimaSincronizacao DateTime?
  syncEnabled         Boolean   @default(false)
  syncIntervalMinutes Int       @default(360)
  lookbackDays        Int       @default(7)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AutoDispatchSettings {
  id                    String    @id @default("singleton")
  enabled               Boolean   @default(false)
  startHour             Int       @default(9)
  endHour               Int       @default(22)
  minIntervalMinutes    Int       @default(30)
  maxIntervalMinutes    Int       @default(60)
  minProductsPerRun     Int       @default(1)
  maxProductsPerRun     Int       @default(2)
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  updatedAt             DateTime  @updatedAt
}
