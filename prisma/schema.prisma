generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; valid values enforced in app code:
// "DISCONNECTED" | "CONNECTING" | "CONNECTED"
model WhatsAppAccount {
  id          String          @id @default(cuid())
  name        String
  phoneNumber String?
  status      String          @default("DISCONNECTED")
  authDir     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  groups      WhatsAppGroup[]
}

model WhatsAppGroup {
  id                String            @id @default(cuid())
  jid               String            @unique
  name              String
  isMonitoring      Boolean           @default(false)
  isSending         Boolean           @default(false)
  // Comma-separated marketplace ids (e.g. "shopee,amazon"). Empty string = todas aceitas.
  monitoredMarketplaces String        @default("")
  // Reaproveita a imagem original da mensagem capturada em vez de gerar link preview.
  useOriginalImage  Boolean           @default(true)
  // So um grupo deveria ter isso ativo por vez (e o "controle remoto" do bot).
  isAutomationGroup Boolean           @default(false)
  participantsCount Int               @default(0)
  lastSyncedAt      DateTime          @default(now())
  account           WhatsAppAccount   @relation(fields: [accountId], references: [id])
  accountId         String
  capturedProducts  CapturedProduct[]
}

model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  // "shopee" | "amazon" | "mercadolivre" | "" (generico, serve pra qualquer marketplace)
  marketplace String  @default("")
  content    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// SQLite has no native enum support in Prisma; valid values enforced in app code:
// "CAPTURED" | "CONVERTED" | "CONVERSION_FAILED"
model CapturedProduct {
  id              String        @id @default(cuid())
  sourceUrl       String
  dedupeKey       String
  marketplace     String
  affiliateUrl    String?
  status          String        @default("CAPTURED")
  conversionError String?
  messageText     String?
  // Caminho local do arquivo (data/media/...), quando o grupo usa "imagem original".
  imagePath       String?
  // salvar_prioridade: entra na frente da fila do disparo automatico.
  priority        Boolean       @default(false)
  // Marcado quando o disparo automatico ja mandou esse produto (evita repetir).
  dispatchedAt    DateTime?
  sourceGroup     WhatsAppGroup @relation(fields: [sourceGroupId], references: [id])
  sourceGroupId   String
  capturedAt      DateTime      @default(now())

  @@index([dedupeKey])
  @@index([capturedAt])
}

model ScheduledMessage {
  id         String    @id @default(cuid())
  // ids de WhatsAppGroup, separados por virgula
  groupIds   String
  text       String?
  productId  String?
  templateId String?
  scheduledAt DateTime
  // "PENDING" | "SENT" | "FAILED" | "CANCELLED"
  status     String    @default("PENDING")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, scheduledAt])
}

model AutoDispatchSettings {
  id                    String    @id @default("singleton")
  enabled               Boolean   @default(false)
  startHour             Int       @default(9)
  endHour               Int       @default(22)
  minIntervalMinutes    Int       @default(30)
  maxIntervalMinutes    Int       @default(60)
  minProductsPerRun     Int       @default(1)
  maxProductsPerRun     Int       @default(2)
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  updatedAt             DateTime  @updatedAt
}
